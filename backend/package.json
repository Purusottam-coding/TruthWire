{
  "name": "truthwire-backend",
  "version": "1.0.0",
  "description": "TruthWire FastAPI Backend Service",
  "scripts": {
    "dev": "powershell -NoProfile -Command \"$env:PYTHONPATH='.'; $env:PYTHONIOENCODING='utf-8'; ..\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload\"",
    "start": "powershell -NoProfile -Command \"$env:PYTHONPATH='.'; $env:PYTHONIOENCODING='utf-8'; ..\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000\"",
    "test": "powershell -NoProfile -Command \"$env:PYTHONPATH='.'; $env:PYTHONIOENCODING='utf-8'; ..\\.venv\\Scripts\\python.exe tests\\test_api.py\""
  }
}
