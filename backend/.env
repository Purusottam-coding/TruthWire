# TruthWire Environment Configuration

# Database (defaults to local sqlite for zero-setup dev; use postgresql:// for production)
DATABASE_URL=sqlite:///./truthwire.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthwire

# App settings
ENVIRONMENT=development
SECRET_KEY=truthwire-dev-secret-key-change-in-production-2026
LOG_LEVEL=INFO
PYTHONIOENCODING=utf-8

# Server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Pilot Countries (ISO2 codes, extensible worldwide)
PILOT_COUNTRIES=NP,US,CA

# Source Polling Intervals (seconds)
INGEST_POLL_INTERVAL=300
